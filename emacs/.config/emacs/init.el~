(setq custom-file "~/.config/emacs/custom.el")
(load custom-file)

(add-to-list 'load-path "~/.config/emacs/lisp/packages")
(add-to-list 'custom-theme-load-path "~/.config/emacs/lisp/themes")

;; Handle startup screen
(setq inhibit-startup-screen t)

;; Hide menu bar, tool bar, scroll bar
(setq menu-tool-scroll-bar-enabled nil)

(cond
 (menu-tool-scroll-bar-enabled
  (menu-bar-mode 1)
  (tool-bar-mode 1)
  (scroll-bar-mode 1))
 ((not menu-tool-scroll-bar-enabled)
  (menu-bar-mode -1)
  (tool-bar-mode -1)
  (scroll-bar-mode -1)))

;; Show line numbers
(global-display-line-numbers-mode 1)
(setq-default display-line-numbers-type 'relative)

(savehist-mode 1)
(setq-default indent-tabs-mode nil)

;; Custom keybinds
(global-set-key (kbd "C-x c") 'compile)

;; Start maximized
(add-to-list 'default-frame-alist '(fullscreen . maximized))

;; Font
(add-to-list 'default-frame-alist `(font . ,(pcase system-type
    ('windows-nt "Consolas-13")
    ('gnu/linux "JetBrainsMono Nerd Font-18"))))

;; Automaticcally open symlinks from VCS repo's
(setq vc-follow-symlinks nil)

;; Set up MELPA
(require 'package)
(add-to-list 'package-archives '("melpa" . "https://melpa.org/packages/") t)
(add-to-list 'package-archives '("melpa-stable" . "https://stable.melpa.org/packages/") t)
(package-initialize)

;; Set up use-package
(require 'use-package)
(setq use-package-always-ensure t)

;; Configure theme
(setq custom-safe-themes 't)
(use-package gruber-darker-theme)
(use-package base16-theme)

(setq my-current-gui-theme 'base16-material-darker)
(setq my-current-tui-theme 'base16-material-darker-tui)

(if (display-graphic-p)
  (load-theme my-current-gui-theme t)
  (load-theme my-current-tui-theme t))

(set-face-attribute 'line-number nil :background nil)
(set-fringe-mode 0)

;; Configure Ido
(use-package ido)
(use-package ido-completing-read+)
(use-package ido-vertical-mode)

(ido-mode 1)
(ido-everywhere 1)
(ido-ubiquitous-mode 1)
(ido-vertical-mode 1)

(setq ido-vertical-define-keys 'C-n-C-p)

(setq ido-auto-merge-delay-time nil)             ; Stop autocorrecting
(setq ido-auto-merge-work-directories-length -1) ; Stop searching in other directories
(setq ido-confirm-unique-completion t)

(add-hook 'ido-setup-hook
  (lambda ()
    (define-key ido-completion-map (kbd "<C-return>") 'ido-select-text)))

;; Configure recentf (open recently opened files
(use-package recentf)
(recentf-mode 1)
(global-set-key (kbd "C-x f") 'recentf-open-files)

;; Configure multiple cursors
(use-package multiple-cursors)
(global-set-key (kbd "C-S-c C-S-c") 'mc/edit-lines)
(global-set-key (kbd "C->") 'mc/mark-next-like-this)
(global-set-key (kbd "C-<") 'mc/mark-previous-like-this)
(global-set-key (kbd "C-c C-<") 'mc/mark-all-like-this)

;; Configure evil mode
(use-package evil)
(evil-mode -1)
(evil-set-initial-state 'dired-mode 'emacs)

;; Configure magit
(use-package magit)

;; Configure vterm
(use-package vterm)
(use-package eterm-256color)
(add-hook 'term-mode-hook #'eterm-256color-mode)
(add-hook 'ansi-term-mode-hook #'eterm-256color-mode)

;; Configure c-mode
(setq-default indent-tabs-mode nil)
(setq-default tab-width 4)
(setq-default c-set-style "allman")
(setq-default c-basic-offset 4)

;; Configure ansi-color
(use-package ansi-color)

(defun my/ansi-color-compilation-filter ()
  (let ((inhibit-read-only t))
    (ansi-color-apply-on-region (point-min) (point-max))))

(add-hook 'compilation-filter-hook 'my/ansi-color-compilation-filter)

;; Configure Dired
(use-package nerd-icons-dired)
(add-hook 'dired-mode-hook #'nerd-icons-dired-mode)
(setq dired-create-destination-dirs 'ask)


;; Custom Keybinds
(global-set-key (kbd "C-x C-b") 'ibuffer)
